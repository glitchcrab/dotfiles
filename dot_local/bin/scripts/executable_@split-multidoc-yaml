#!/usr/bin/env python3
import sys
import yaml
from pathlib import Path


def split_yaml(input_file: str, output_dir: str = ".") -> None:
    out = Path(output_dir)
    out.mkdir(parents=True, exist_ok=True)

    with open(input_file, "r") as f:
        documents = list(yaml.safe_load_all(f))

    written = []
    skipped = 0

    for i, doc in enumerate(documents):
        if doc is None:
            skipped += 1
            continue

        kind = doc.get("kind")
        name = doc.get("metadata", {}).get("name")

        if not kind or not name:
            print(f"[warn] Document {i+1} ({doc}) missing 'kind' or 'metadata.name' — skipping.")
            skipped += 1
            continue

        filename = out / f"{kind}-{name}.yaml"
        with open(filename, "w") as f:
            yaml.dump(doc, f, default_flow_style=False, allow_unicode=True)

        written.append(filename.name)

    print(f"Written {len(written)} file(s){f' to {output_dir}' if output_dir != '.' else ''}:")
    for name in written:
        print(f"  {name}")
    if skipped:
        print(f"Skipped {skipped} document(s).")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python split_yaml.py <input.yaml> [output_dir]")
        sys.exit(1)

    input_file = sys.argv[1]
    output_dir = sys.argv[2] if len(sys.argv) > 2 else "."
    split_yaml(input_file, output_dir)
